<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms only for Screen.PrimaryScreen pixel bounds when capturing
         the desktop screenshot. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Winmarchy.Chooser</AssemblyName>
    <RootNamespace>Winmarchy.Chooser</RootNamespace>
    <!-- The Winmarchy mark, generated by tools/make-icon.py. This gives the
         executable its icon in Explorer, the taskbar and Task Manager, and
         WinForms windows pick it up as their default window icon. -->
    <ApplicationIcon>winmarchy.ico</ApplicationIcon>
    <!-- Truthful identity in the file's version resource. An executable with
         no publisher, no description and no version, which installs a
         keyboard hook and starts at login, is indistinguishable to a
         reputation system from something that means harm. Saying plainly
         what this is and who wrote it costs nothing and is simply accurate;
         see docs/defender.md. -->
    <Product>Winmarchy</Product>
    <AssemblyTitle>Winmarchy chooser, bar, menu and tray</AssemblyTitle>
    <Description>Winmarchy: an Omarchy-inspired desktop mode for Windows 11. Hosts the login chooser, the status bar, the system menu and the notification area icon.</Description>
    <Company>Winmarchy (github.com/Mathew-Harvey/WinOmarchy)</Company>
    <Copyright>MIT licensed. See LICENSE in the repository.</Copyright>
    <Version>1.0.0</Version>
    <!-- Allows building this Windows-targeted project from the Linux build
         container; the produced binaries still run on Windows only. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The chooser is built on the user's own machine with whatever .NET SDK
         they have. Without this, a net8.0 app refuses to start when only a
         newer Desktop Runtime is installed (the default rollForward is Minor,
         which will not cross a major version), and a WinExe failing that way
         shows nothing useful at login. LatestMajor lets it run on 8 or later.
         Documented MSBuild property: learn.microsoft.com/dotnet/core/project-sdk
         /msbuild-props (RollForward) and /dotnet/core/versions/selection. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ui\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
