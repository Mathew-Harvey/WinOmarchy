<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Winmarchy Setup"
  Width="940" Height="680"
  WindowStartupLocation="CenterScreen"
  ResizeMode="NoResize"
  FontFamily="Segoe UI"
  Background="#13141c">

  <!-- Loaded by install-ui.ps1 through XamlReader, so this file carries no
       x:Class and no event attributes; every handler is wired in PowerShell.
       Colours are Winmarchy's own chrome (tokyo-night); the theme picker
       previews the chosen palette in its own panel. -->

  <Window.Resources>
    <SolidColorBrush x:Key="Fg" Color="#c0caf5" />
    <SolidColorBrush x:Key="FgDim" Color="#a9b1d6" />
    <SolidColorBrush x:Key="FgMuted" Color="#565f89" />
    <SolidColorBrush x:Key="Accent" Color="#7aa2f7" />
    <SolidColorBrush x:Key="Panel" Color="#1a1b26" />
    <SolidColorBrush x:Key="PanelAlt" Color="#24283b" />
    <SolidColorBrush x:Key="Good" Color="#9ece6a" />
    <SolidColorBrush x:Key="Bad" Color="#f7768e" />

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#c0caf5" />
      <Setter Property="FontSize" Value="25" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#565f89" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,18" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#a9b1d6" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style x:Key="Flat" TargetType="Button">
      <Setter Property="Foreground" Value="#c0caf5" />
      <Setter Property="Background" Value="#24283b" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="22,9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    CornerRadius="5" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#2f3450" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#1a1b26" />
                <Setter Property="Foreground" Value="#3d4260" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Flat}">
      <Setter Property="Background" Value="#7aa2f7" />
      <Setter Property="Foreground" Value="#13141c" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Check" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#c0caf5" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="StepText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#565f89" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="228" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="74" />
    </Grid.RowDefinitions>

    <!-- Step rail -->
    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="#0e0e14">
      <StackPanel Margin="26,30,20,0">
        <TextBlock Text="Winmarchy" Foreground="#c0caf5" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="Setup" Foreground="#7aa2f7" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,30" />
        <TextBlock x:Name="Step0" Text="1  Welcome" Style="{StaticResource StepText}" />
        <TextBlock x:Name="Step1" Text="2  System check" Style="{StaticResource StepText}" />
        <TextBlock x:Name="Step2" Text="3  Theme" Style="{StaticResource StepText}" />
        <TextBlock x:Name="Step3" Text="4  Components" Style="{StaticResource StepText}" />
        <TextBlock x:Name="Step4" Text="5  Review" Style="{StaticResource StepText}" />
        <TextBlock x:Name="Step5" Text="6  Install" Style="{StaticResource StepText}" />
        <TextBlock x:Name="Step6" Text="7  Finish" Style="{StaticResource StepText}" />
      </StackPanel>
    </Border>

    <!-- Page area -->
    <Grid Grid.Row="0" Grid.Column="1" Margin="34,30,34,0">

      <!-- 0: Welcome -->
      <StackPanel x:Name="PageWelcome" Visibility="Visible">
        <TextBlock Text="Two desktops, one machine" Style="{StaticResource H1}" />
        <TextBlock Text="This sets up Winmarchy on your Windows 11 PC." Style="{StaticResource Sub}" />
        <TextBlock Style="{StaticResource Body}"
                   Text="Winmarchy gives this machine a second personality: tiling windows driven from the Super key, a slim themed bar instead of the taskbar, a keyboard launcher, and one colour palette running through the terminal, the editor and the wallpaper. Your normal Windows 11 desktop stays exactly as it is, and you pick between them at login or swap at any time." />
        <TextBlock Style="{StaticResource Body}"
                   Text="Winmarchy itself installs into your own user profile and needs no administrator rights. Some of the apps it fetches are machine-wide, so Windows will ask you to approve those. Approve each one: dismissing a prompt skips that app. Nothing is overwritten without a backup taken first, and if a backup ever fails the installer stops rather than continuing." />
        <Border Background="#1a1b26" CornerRadius="6" Padding="18,14" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="You can always get back" Foreground="#9ece6a" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBlock Style="{StaticResource Body}" Margin="0"
                       Text="Windows Explorer is never replaced. A panic key (Super plus Shift plus X), a Start menu repair shortcut and a one-line command all return you to a stock desktop, and the uninstaller puts everything back the way it was." />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 1: System check -->
      <StackPanel x:Name="PageChecks" Visibility="Collapsed">
        <TextBlock Text="System check" Style="{StaticResource H1}" />
        <TextBlock Text="What this machine already has." Style="{StaticResource Sub}" />
        <ItemsControl x:Name="ChecksList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,0,0,13">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Mark}" Foreground="{Binding MarkColour}" FontSize="14" FontWeight="Bold" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#c0caf5" FontSize="13.5" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="#565f89" FontSize="13" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="ChecksVerdict" Style="{StaticResource Body}" Margin="0,16,0,0" />
      </StackPanel>

      <!-- 2: Theme -->
      <Grid x:Name="PageTheme" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Text="Pick a palette" Style="{StaticResource H1}" />
          <TextBlock Text="One choice colours the bar, the window borders, the terminal, Neovim and the wallpaper. You can change it any time with Super plus Ctrl plus Space." Style="{StaticResource Sub}" />
        </StackPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ListBox x:Name="ThemeList" Grid.Column="0" Background="#1a1b26" BorderThickness="0"
                   Foreground="#c0caf5" FontSize="14" Margin="0,0,20,26">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,7">
                  <TextBlock Text="{Binding Label}" Foreground="#c0caf5" FontSize="14" />
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Width="17" Height="9" CornerRadius="2" Margin="0,0,4,0" Background="{Binding AccentColour}" />
                    <Border Width="17" Height="9" CornerRadius="2" Margin="0,0,4,0" Background="{Binding RedColour}" />
                    <Border Width="17" Height="9" CornerRadius="2" Margin="0,0,4,0" Background="{Binding GreenColour}" />
                    <Border Width="17" Height="9" CornerRadius="2" Margin="0,0,4,0" Background="{Binding YellowColour}" />
                    <Border Width="17" Height="9" CornerRadius="2" Background="{Binding MagentaColour}" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Live mock of the Omarchy desktop in the selected palette -->
          <Border x:Name="PreviewRoot" Grid.Column="1" CornerRadius="8" Background="#1a1b26" Margin="0,0,0,26">
            <Grid Margin="14">
              <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border x:Name="PreviewBar" Grid.Row="0" CornerRadius="5" Padding="10,0">
                <Grid>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="PreviewWs1" Width="9" Height="9" CornerRadius="5" Margin="0,0,5,0" />
                    <Border x:Name="PreviewWs2" Width="9" Height="9" CornerRadius="5" Margin="0,0,5,0" />
                    <Border x:Name="PreviewWs3" Width="9" Height="9" CornerRadius="5" />
                  </StackPanel>
                  <TextBlock x:Name="PreviewClock" Text="Fri 01 Aug  21:34" HorizontalAlignment="Right"
                             VerticalAlignment="Center" FontFamily="Consolas" FontSize="11.5" />
                </Grid>
              </Border>
              <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.5*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PreviewTileFocused" Grid.Column="0" CornerRadius="6" BorderThickness="2" Padding="14">
                  <StackPanel>
                    <Border x:Name="PreviewLine1" Height="8" CornerRadius="4" Width="120" HorizontalAlignment="Left" Margin="0,0,0,9" />
                    <Border x:Name="PreviewLine2" Height="8" CornerRadius="4" Width="160" HorizontalAlignment="Left" Margin="0,0,0,9" />
                    <Border x:Name="PreviewLine3" Height="8" CornerRadius="4" Width="80" HorizontalAlignment="Left" Margin="0,0,0,9" />
                    <Border x:Name="PreviewPrompt" Height="8" CornerRadius="4" Width="50" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
                <Border x:Name="PreviewTileOther" Grid.Column="2" CornerRadius="6" BorderThickness="2" Padding="14">
                  <StackPanel>
                    <Border x:Name="PreviewLine4" Height="8" CornerRadius="4" Width="110" HorizontalAlignment="Left" Margin="0,0,0,9" />
                    <Border x:Name="PreviewLine5" Height="8" CornerRadius="4" Width="70" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </Grid>
              <TextBlock x:Name="PreviewCaption" Grid.Row="2" Margin="2,12,0,0" FontSize="12" Foreground="#565f89" />
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- 3: Components -->
      <StackPanel x:Name="PageComponents" Visibility="Collapsed">
        <TextBlock Text="What to set up" Style="{StaticResource H1}" />
        <TextBlock Text="Everything here is optional. Anything you skip can be added later by running setup again." Style="{StaticResource Sub}" />

        <CheckBox x:Name="OptApps" Style="{StaticResource Check}" Content="Install the apps with winget" />
        <TextBlock x:Name="OptAppsNote" Foreground="#565f89" FontSize="12.5" TextWrapping="Wrap" Margin="26,0,0,16" />

        <CheckBox x:Name="OptChooser" Style="{StaticResource Check}" Content="Build the login chooser" />
        <TextBlock x:Name="OptChooserNote" Foreground="#565f89" FontSize="12.5" TextWrapping="Wrap" Margin="26,0,0,16" />

        <CheckBox x:Name="OptAutostart" Style="{StaticResource Check}" Content="Show the chooser when I log in" />
        <TextBlock x:Name="OptAutostartNote" Foreground="#565f89" FontSize="12.5" TextWrapping="Wrap" Margin="26,0,0,16" />

        <CheckBox x:Name="OptTray" Style="{StaticResource Check}" Content="Put a Winmarchy icon by the clock" />
        <TextBlock x:Name="OptTrayNote" Foreground="#565f89" FontSize="12.5" TextWrapping="Wrap" Margin="26,0,0,16" />

        <TextBlock Text="Wallpapers" Foreground="#c0caf5" FontSize="15" Margin="0,6,0,4" />
        <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="OptWallpaperDir" Grid.Column="0" Height="30" VerticalContentAlignment="Center"
                   Background="#16161e" Foreground="#c0caf5" BorderBrush="#414868" Padding="6,0" />
          <Button x:Name="BtnBrowseWallpapers" Grid.Column="1" Content="Browse" Margin="8,0,0,0" Padding="14,4"
                  Background="#24283b" Foreground="#c0caf5" BorderBrush="#414868" />
          <Button x:Name="BtnClearWallpapers" Grid.Column="2" Content="Clear" Margin="8,0,0,0" Padding="14,4"
                  Background="#24283b" Foreground="#c0caf5" BorderBrush="#414868" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
          <TextBlock Text="Change every" Foreground="#a9b1d6" FontSize="13" VerticalAlignment="Center" />
          <Slider x:Name="OptWallpaperInterval" Width="240" Minimum="1" Maximum="120" Value="30"
                  TickFrequency="1" IsSnapToTickEnabled="True" Margin="10,0" VerticalAlignment="Center" />
          <TextBlock x:Name="OptWallpaperIntervalLabel" Foreground="#c0caf5" FontSize="13" VerticalAlignment="Center" Text="30 minutes" />
        </StackPanel>
        <TextBlock x:Name="OptWallpaperNote" Foreground="#565f89" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="Optional. Point at a folder of pictures (subfolders are included) and BOTH modes deal a random one from it: on every swap, on every theme change, and on the slider's interval. Leave the folder empty and Omarchy mode uses its generated theme wallpapers while Windows keeps yours." />
      </StackPanel>

      <!-- 4: Review -->
      <Grid x:Name="PageReview" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Text="Ready to go" Style="{StaticResource H1}" />
          <TextBlock Text="Nothing has been changed yet. Here is exactly what will happen." Style="{StaticResource Sub}" />
        </StackPanel>
        <Border Grid.Row="1" Background="#1a1b26" CornerRadius="6" Padding="18,14" Margin="0,0,0,14">
          <StackPanel x:Name="ReviewSummary" />
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,26">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Step by step" Foreground="#565f89" FontSize="12.5" Margin="0,0,0,6" />
          <Border Grid.Row="1" Background="#0e0e14" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
              <TextBlock x:Name="ReviewPlan" Foreground="#a9b1d6" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>

      <!-- 5: Install -->
      <Grid x:Name="PageInstall" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Text="Setting up" Style="{StaticResource H1}" />
          <TextBlock x:Name="InstallStatus" Text="Working..." Style="{StaticResource Sub}" />
        </StackPanel>
        <ProgressBar x:Name="InstallProgress" Grid.Row="1" Height="4" IsIndeterminate="True"
                     Background="#1a1b26" Foreground="#7aa2f7" BorderThickness="0" Margin="0,0,0,14" />
        <Border Grid.Row="2" Background="#0e0e14" CornerRadius="6" Margin="0,0,0,26">
          <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" Padding="14,10">
            <TextBlock x:Name="InstallLog" Foreground="#a9b1d6" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- 6: Done -->
      <StackPanel x:Name="PageDone" Visibility="Collapsed">
        <TextBlock x:Name="DoneTitle" Text="Winmarchy is installed" Style="{StaticResource H1}" />
        <TextBlock x:Name="DoneSub" Style="{StaticResource Sub}" />
        <Border Background="#1a1b26" CornerRadius="6" Padding="18,14" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="The ten keys worth knowing" Foreground="#7aa2f7" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock Foreground="#a9b1d6" FontFamily="Consolas" FontSize="12.5" LineHeight="20"><Run Text="Super + Enter          terminal" /><LineBreak /><Run Text="Super + Space          launcher" /><LineBreak /><Run Text="Super + 1 to 9         switch workspace" /><LineBreak /><Run Text="Super + arrows         move focus" /><LineBreak /><Run Text="Super + Shift + arrows move the window" /><LineBreak /><Run Text="Super + W              close the window" /><LineBreak /><Run Text="Super + F              fullscreen" /><LineBreak /><Run Text="Super + Ctrl + Space   next theme" /><LineBreak /><Run Text="Super + Escape         menu" /><LineBreak /><Run Text="Super + Shift + X      back to Windows 11" /></TextBlock>
          </StackPanel>
        </Border>
        <TextBlock x:Name="DoneWarnings" Foreground="#e0af68" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />
        <CheckBox x:Name="OptEnterNow" Style="{StaticResource Check}" Content="Start Omarchy mode when I close this" />
      </StackPanel>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="1" Grid.Column="1" Background="#13141c">
      <Grid Margin="34,0,34,22">
        <TextBlock x:Name="FooterNote" Foreground="#565f89" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" TextWrapping="Wrap" Width="360" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="BtnCancel" Style="{StaticResource Flat}" Content="Cancel" Margin="0,0,10,0" />
          <Button x:Name="BtnBack" Style="{StaticResource Flat}" Content="Back" Margin="0,0,10,0" />
          <Button x:Name="BtnNext" Style="{StaticResource Primary}" Content="Next" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
